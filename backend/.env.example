# ─────────────────────────────────────────────────────────────────────────────
# Cascade backend configuration. Copy to `.env` and fill in.
#
# Two chains are involved:
#   - MARKETS chain (Creditcoin testnet) — where Markets.sol is deployed. We
#     index MarketCreated/Resolved/Cancelled to keep a registry of live markets.
#   - SOURCE chain (Ethereum Sepolia) — where the real events a market predicts
#     actually happen (Aave V3 Supply/Borrow, ERC20 Transfer, Uniswap V3 Swap).
#     We watch these against every open market's condition.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP API
PORT=4000
LOG_LEVEL=info

# ── Markets chain: Creditcoin testnet (chain 102031) ─────────────────────────
MARKETS_CHAIN_ID=102031
MARKETS_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# Deployed Markets.sol address. Nothing is deployed yet — set once it is.
MARKETS_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
MARKETS_START_BLOCK=latest

# ── Source chain: Ethereum Sepolia (chain 11155111) ─────────────────────────
SOURCE_CHAIN_ID=11155111
SOURCE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SOURCE_START_BLOCK=latest

# ── Indexer tuning (applies to both watchers) ──────────────────────────────
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_CONFIRMATIONS=2
INDEXER_MAX_BLOCK_RANGE=2000

# ── Resolution: Attestcoin proof + Markets.resolve(...) submission ──────────
# Account that signs & pays for resolve() txs on the MARKETS chain. Leave unset
# and the resolver stays idle (the matcher still flags conditionMet).
# RESOLVER_PRIVATE_KEY=0x...
# Attestcoin Proof Builder service (Creditcoin testnet default shown).
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
# Fallback Attestcoin chainKey for the SOURCE chain, used only when a market's
# on-chain chainKey couldn't be read. Sepolia = 1, Ethereum mainnet = 3
# (from the Creditcoin testnet ChainInfo precompile).
SOURCE_CHAIN_KEY=1
# Queue worker cadence, retry ceiling, and attestation-wait bounds.
RESOLUTION_QUEUE_INTERVAL_MS=15000
RESOLUTION_MAX_ATTEMPTS=15
PROOF_ATTEST_POLL_INTERVAL_MS=15000
PROOF_ATTEST_TIMEOUT_MS=1800000
# Per-request timeout for the ethers RPC providers in the resolution path.
# Public testnet RPCs are flaky; a single slow response otherwise burns a whole
# resolution attempt as `request timeout (code=TIMEOUT)`.
RPC_REQUEST_TIMEOUT_MS=60000

# ── Firebase ───────────────────────────────────────────────────────────────
# Base64-encoded Firebase service account JSON (the whole file, base64'd):
#   base64 -w0 service-account.json      # linux
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))  # powershell
# Leave unset to run the backend without Firestore.
# CRED=
