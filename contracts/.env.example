# Deployer private key used for the creditcoinTestnet network. Never commit
# a real key — copy this file to .env and fill it in locally.
PRIVATE_KEY=

# Optional: API key for verifying contracts on the Blockscout instance.
# Most Blockscout deployments accept any non-empty string.
BLOCKSCOUT_API_KEY=abc

# Set to "true" to print gas usage after running tests.
REPORT_GAS=false
