{
  "name": "contracts",
  "version": "1.0.0",
  "description": "Cascade smart contracts (Hardhat 2)",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/Lock.ts --network localhost",
    "deploy:creditcoin-testnet": "hardhat ignition deploy ignition/modules/Lock.ts --network creditcoinTestnet",
    "deploy:markets:local": "hardhat ignition deploy ignition/modules/Markets.ts --network localhost",
    "deploy:markets:creditcoin-testnet": "hardhat ignition deploy ignition/modules/Markets.ts --network creditcoinTestnet",
    "market:create": "hardhat run scripts/interactions/createMarket.ts --network creditcoinTestnet",
    "market:bet": "hardhat run scripts/interactions/bet.ts --network creditcoinTestnet",
    "market:claim": "hardhat run scripts/interactions/claim.ts --network creditcoinTestnet",
    "token:deploy:sepolia": "hardhat run scripts/deployTestToken.ts --network sepolia",
    "token:mint:sepolia": "hardhat run scripts/mintTestToken.ts --network sepolia",
    "token:transfer:sepolia": "hardhat run scripts/transferTestToken.ts --network sepolia"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "chai": "^4.5.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@gluwa/asc-contracts": "^0.2.1",
    "@gluwa/usc-contracts": "^0.2.0"
  }
